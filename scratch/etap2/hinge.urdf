<?xml version="1.0"?>
<robot name="hinge">
    <link name="support">
        <visual>
            <origin xyz="0 0 1.01"/>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 1.01"/>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 1.01"/>
            <mass value="0.0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
    </link>
    <joint name="hinge" type="revolute">
        <parent link="support"/>
        <child link="arm"/>
        <origin xyz="0 0 1.0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="5" velocity="10"/>
    </joint>
    <link name="arm">
        <visual>
            <origin xyz="0 0 -0.25"/>
            <geometry>
                <box size="0.02 0.02 0.5"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -0.25"/>
            <geometry>
                <box size="0.02 0.02 0.5"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 -0.25"/>         <!-- centre of mass in the middle of the bar -->
            <mass value="0.5"/>
            <inertia ixx="0.010433333333333334" ixy="0" ixz="0" iyy="0.010433333333333334" iyz="0"
                     izz="3.3333333333333335e-05"/>
        </inertial>
    </link>
</robot>
